rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'password'
        && exists(/databases/$(database)/documents/staff/$(request.auth.uid))
        && get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.role == 'admin';
    }

    function isJudge() {
      return request.auth != null
        && exists(/databases/$(database)/documents/staff/$(request.auth.uid))
        && get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.role == 'judge';
    }
    function isAssignedJudge(eventId) {
      return isJudge() && eventId in get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.get('assignedEventIds', []);
    }

    match /staff/{staffId} {
      allow read: if request.auth != null && (request.auth.uid == staffId || isAdmin());
      // New accounts can only create a member profile; they cannot grant themselves privileges.
      allow create: if request.auth != null
        && request.auth.uid == staffId
        && request.auth.token.firebase.sign_in_provider == 'password'
        && request.resource.data.keys().hasOnly(['email','role','createdAt'])
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.role == 'member'
        && request.resource.data.createdAt == request.time;
      // Administrators can approve/revoke judges, but cannot create other admins.
      allow update: if isAdmin()
        && staffId != request.auth.uid
        && resource.data.role != 'admin'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role','assignedEventIds'])
        && request.resource.data.role in ['judge','member']
        && request.resource.data.get('assignedEventIds', []) is list
        && request.resource.data.get('assignedEventIds', []).size() <= 100;
      allow delete: if false;
    }

    match /events/{eventId} {
      allow read: if request.auth != null;

      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['title', 'mode', 'date', 'location', 'fee', 'notes', 'capacity', 'registrationCount', 'ownerUid', 'open', 'deleted', 'createdAt'])
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 1
        && request.resource.data.title.size() <= 80
        && request.resource.data.mode in ['league', 'knockout']
        && request.resource.data.date is string
        && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.location is string
        && request.resource.data.location.size() >= 1
        && request.resource.data.location.size() <= 100
        && request.resource.data.fee is int
        && request.resource.data.fee >= 0
        && request.resource.data.fee <= 1000000
        && request.resource.data.notes is string
        && request.resource.data.notes.size() <= 500
        && request.resource.data.capacity is int
        && request.resource.data.capacity >= 2
        && request.resource.data.capacity <= 64
        && request.resource.data.registrationCount == 0
        && request.resource.data.deleted == false
        && request.resource.data.open == true
        && request.resource.data.createdAt == request.time;

      allow update: if request.auth != null
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['open', 'deleted'])
        && request.resource.data.open is bool
        && (
          (resource.data.get('deleted', false) == false && request.resource.data.get('deleted', false) == false)
          ||
          (resource.data.get('deleted', false) == false && request.resource.data.deleted == true && request.resource.data.open == false)
        );

      allow update: if request.auth != null
        && resource.data.ownerUid == request.auth.uid
        && resource.data.get('deleted', false) == false
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['capacity','open'])
        && request.resource.data.open == true
        && request.resource.data.capacity is int
        && request.resource.data.capacity > resource.data.capacity
        && request.resource.data.capacity <= 64
        && request.resource.data.capacity >= resource.data.registrationCount;

      allow update: if request.auth != null
        && resource.data.get('deleted', false) == false
        && resource.data.keys().hasAll(['capacity','registrationCount'])
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['registrationCount'])
        && request.resource.data.registrationCount is int
        && request.resource.data.registrationCount >= 0
        && request.resource.data.registrationCount <= resource.data.capacity
        && (request.resource.data.registrationCount == resource.data.registrationCount + 1
          || request.resource.data.registrationCount == resource.data.registrationCount - 1)
        && (request.resource.data.registrationCount < resource.data.registrationCount
          || resource.data.open == true);

      allow delete: if false;

      match /matchLocks/{matchId} {
        allow read: if request.auth != null && (isAdmin() || isAssignedJudge(eventId));
        allow create: if isAssignedJudge(eventId)
          && request.resource.data.keys().hasOnly(['uid','matchId','expiresAt','updatedAt'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.matchId == int(matchId)
          && request.resource.data.expiresAt is number
          && request.resource.data.expiresAt > request.time.toMillis()
          && request.resource.data.expiresAt <= request.time.toMillis() + 130000
          && request.resource.data.updatedAt == request.time;
        allow update: if isAssignedJudge(eventId)
          && request.resource.data.keys().hasOnly(['uid','matchId','expiresAt','updatedAt'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.matchId == resource.data.matchId
          && (resource.data.uid == request.auth.uid || resource.data.expiresAt <= request.time.toMillis())
          && request.resource.data.expiresAt > request.time.toMillis()
          && request.resource.data.expiresAt <= request.time.toMillis() + 130000
          && request.resource.data.updatedAt == request.time;
        allow delete: if isAssignedJudge(eventId) && resource.data.uid == request.auth.uid;
      }

      match /public/{documentId} {
        allow delete: if request.auth != null && documentId == 'schedule'
          && get(/databases/$(database)/documents/events/$(eventId)).data.ownerUid == request.auth.uid
          && get(/databases/$(database)/documents/events/$(eventId)).data.get('deleted', false) == false;
        allow read: if request.auth != null && documentId == 'schedule'
          && (!isJudge() || isAssignedJudge(eventId))
          && get(/databases/$(database)/documents/events/$(eventId)).data.get('deleted', false) == false;
        allow create, update: if request.auth != null && documentId == 'schedule'
          && get(/databases/$(database)/documents/events/$(eventId)).data.ownerUid == request.auth.uid
          && get(/databases/$(database)/documents/events/$(eventId)).data.get('deleted', false) == false
          && request.resource.data.keys().hasOnly(['mode','players','matches','updatedAt'])
          && request.resource.data.mode in ['league','knockout']
          && request.resource.data.players is list
          && request.resource.data.players.size() <= 64
          && request.resource.data.matches is list
          && request.resource.data.matches.size() <= 2016
          && request.resource.data.updatedAt == request.time;
        allow update: if documentId == 'schedule' && isAssignedJudge(eventId)
          && resource.data.matches is list
          && request.resource.data.keys().hasOnly(['mode','players','matches','updatedAt','lastJudgeMatchId','lastJudgeUid'])
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['matches','updatedAt','lastJudgeMatchId','lastJudgeUid'])
          && request.resource.data.mode == resource.data.mode
          && request.resource.data.players == resource.data.players
          && request.resource.data.matches is list
          && request.resource.data.matches.size() == resource.data.matches.size()
          && request.resource.data.lastJudgeUid == request.auth.uid
          && request.resource.data.lastJudgeMatchId is int
          && exists(/databases/$(database)/documents/events/$(eventId)/matchLocks/$(request.resource.data.lastJudgeMatchId))
          && getAfter(/databases/$(database)/documents/events/$(eventId)/matchLocks/$(request.resource.data.lastJudgeMatchId)).data.uid == request.auth.uid
          && getAfter(/databases/$(database)/documents/events/$(eventId)/matchLocks/$(request.resource.data.lastJudgeMatchId)).data.expiresAt > request.time.toMillis()
          && request.resource.data.updatedAt == request.time;
        allow delete: if false;
      }

      match /registrations/{registrationId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null
          && !isJudge()
          && exists(/databases/$(database)/documents/events/$(eventId))
          && get(/databases/$(database)/documents/events/$(eventId)).data.open == true
          && get(/databases/$(database)/documents/events/$(eventId)).data.get('deleted', false) == false
          && request.resource.data.keys().hasOnly(['uid', 'name', 'createdAt'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.name is string
          && request.resource.data.name.size() >= 1
          && request.resource.data.name.size() <= 30
          && request.resource.data.createdAt == request.time
          && (!get(/databases/$(database)/documents/events/$(eventId)).data.keys().hasAll(['capacity','registrationCount'])
            || getAfter(/databases/$(database)/documents/events/$(eventId)).data.registrationCount
              == get(/databases/$(database)/documents/events/$(eventId)).data.registrationCount + 1);
        allow update: if isAdmin()
          && get(/databases/$(database)/documents/events/$(eventId)).data.ownerUid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name'])
          && request.resource.data.name is string
          && request.resource.data.name.size() >= 1
          && request.resource.data.name.size() <= 30;
        allow delete: if (isAdmin()
          && get(/databases/$(database)/documents/events/$(eventId)).data.ownerUid == request.auth.uid)
          || (request.auth != null
          && resource.data.uid == request.auth.uid
          && get(/databases/$(database)/documents/events/$(eventId)).data.open == true
          && get(/databases/$(database)/documents/events/$(eventId)).data.get('deleted', false) == false)
          && (!get(/databases/$(database)/documents/events/$(eventId)).data.keys().hasAll(['capacity','registrationCount'])
            || getAfter(/databases/$(database)/documents/events/$(eventId)).data.registrationCount
              == get(/databases/$(database)/documents/events/$(eventId)).data.registrationCount - 1);
      }
    }

    match /events/main/registrations/{registrationId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && !isJudge()
        && request.resource.data.keys().hasOnly(['uid', 'name', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 30
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
